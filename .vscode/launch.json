{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Proyectos.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Proyectos.Api/bin/Debug/net8.0/Proyectos.Api.dll",
      "cwd": "${workspaceFolder}/Proyectos.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5025"
      }
    }
  ]
}
